# Reverse proxy and static web server of the demo environment (I20, ADR-0012).
# SITE_ADDRESS is the public host name (Caddy gets and renews a Let's Encrypt certificate for it), or `localhost` for a
# local run (a certificate from Caddy's own local CA).
{
	# Nothing outside the container uses the admin API.
	admin off
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Same origin for the browser: no CORS, and the owner and auth cookies work as in development (Vite proxy).
	# Caddy sends X-Forwarded-For and X-Forwarded-Proto; the API trusts them (ASPNETCORE_FORWARDEDHEADERS_ENABLED).
	@api path /api/* /fake-checkout /fake-checkout/* /health /alive
	handle @api {
		reverse_proxy api:8080 {
			health_uri /alive
			health_interval 5s
			# While the API restarts (a deploy), requests wait for it up to 30 s instead of failing with 502/503.
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	handle {
		root * /srv
		# The app shell is revalidated on every load, so a deploy is visible at once. Vite puts a content hash into every
		# asset name, so assets never change under the same URL. (The later header wins.)
		header Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Client-side routes (/movies/…, /cart, …) get the app shell.
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
