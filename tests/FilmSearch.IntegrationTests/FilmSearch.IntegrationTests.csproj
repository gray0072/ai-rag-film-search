<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded TMDB responses and the fake TMDB API shared by the unit and integration tests (I16). -->
    <None Include="..\fixtures\tmdb\*.json" Link="fixtures\tmdb\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\fixtures\TmdbStub.cs" Link="Fixtures\TmdbStub.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FilmSearch.Api\FilmSearch.Api.csproj" />
    <!-- Alias: the Worker has a public Program too (top-level statements), like the API used by WebApplicationFactory. -->
    <ProjectReference Include="..\..\src\FilmSearch.Worker\FilmSearch.Worker.csproj" Aliases="worker" />
  </ItemGroup>

</Project>
