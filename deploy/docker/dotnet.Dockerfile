# syntax=docker/dockerfile:1
# .NET images of the demo environment (I20, ADR-0012). One file, two targets that share the restore layer:
#   docker build -f deploy/docker/dotnet.Dockerfile --target api .
#   docker build -f deploy/docker/dotnet.Dockerfile --target worker .
# The migration step is the Worker image with the `migrate` command (deploy/compose.yaml).
# The build context is the repository root.

ARG DOTNET_VERSION=10.0

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src

# Restore first: this layer is reused while the project files and package versions do not change.
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/FilmSearch.Api/FilmSearch.Api.csproj src/FilmSearch.Api/
COPY src/FilmSearch.Worker/FilmSearch.Worker.csproj src/FilmSearch.Worker/
COPY src/FilmSearch.AI/FilmSearch.AI.csproj src/FilmSearch.AI/
COPY src/FilmSearch.Core/FilmSearch.Core.csproj src/FilmSearch.Core/
COPY src/FilmSearch.Infrastructure/FilmSearch.Infrastructure.csproj src/FilmSearch.Infrastructure/
COPY src/FilmSearch.ServiceDefaults/FilmSearch.ServiceDefaults.csproj src/FilmSearch.ServiceDefaults/
RUN dotnet restore src/FilmSearch.Api \
    && dotnet restore src/FilmSearch.Worker

COPY data/seed/movies.seed.json data/seed/
COPY src/FilmSearch.Api/ src/FilmSearch.Api/
COPY src/FilmSearch.Worker/ src/FilmSearch.Worker/
COPY src/FilmSearch.AI/ src/FilmSearch.AI/
COPY src/FilmSearch.Core/ src/FilmSearch.Core/
COPY src/FilmSearch.Infrastructure/ src/FilmSearch.Infrastructure/
COPY src/FilmSearch.ServiceDefaults/ src/FilmSearch.ServiceDefaults/

# Framework-dependent and portable: the same output runs on amd64 and arm64 base images.
# The OpenAPI document is generated by the normal build (CI checks it), not inside the image.
FROM build AS publish-api
RUN dotnet publish src/FilmSearch.Api -c Release -o /out --no-restore -p:OpenApiGenerateDocuments=false \
    && mkdir -p /keys

FROM build AS publish-worker
RUN dotnet publish src/FilmSearch.Worker -c Release -o /out --no-restore

# Chiseled images: no shell or package manager, non-root user `app` (uid 1654). "extra" adds ICU and time zones,
# needed for the ru and sv cultures.
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}-noble-chiseled-extra AS api
# Every image of the project carries this label: docker images --filter label=project=filmsearch finds them.
LABEL project=filmsearch
WORKDIR /app
COPY --from=publish-api /out ./
# Data protection keys (DataProtection:KeysPath): a named volume mounted here copies this owner on first use.
COPY --from=publish-api --chown=1654:1654 /keys /var/lib/filmsearch/keys
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "FilmSearch.Api.dll"]

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}-noble-chiseled-extra AS worker
LABEL project=filmsearch
WORKDIR /app
COPY --from=publish-worker /out ./
ENTRYPOINT ["dotnet", "FilmSearch.Worker.dll"]
