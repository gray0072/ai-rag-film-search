{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Catalog": {
    "Seed": {
      "LoadOnStartup": true
    }
  },
  "Search": {
    "Embeddings": {
      "IndexOnStartup": true
    }
  },
  "DataProtection": {
    "KeysPath": "/var/lib/filmsearch/keys"
  },
  "RateLimiting": {
    "Enabled": true,
    "Chat": { "PermitLimit": 10, "WindowSeconds": 60 },
    "NewConversation": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Search": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "Assistant": {
    "MaxConversationTokens": 100000,
    "MaxOwnerTokensPerDay": 200000,
    "MaxTotalTokensPerDay": 5000000
  },
  "Payments": {
    "Provider": "Fake"
  },
  "AI": {
    "ActiveChatProfile": "openrouter",
    "ActiveEmbeddingProfile": "openrouter",
    "EnableSensitiveData": false,
    "LogRawHttp": false
  }
}
