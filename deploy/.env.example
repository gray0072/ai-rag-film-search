# Demo environment settings (deploy/README.md). Copy to .env next to compose.yaml; .env is never committed.

# Images: ghcr.io/<github-owner>/filmsearch-{api,worker,web}:<tag>. Local builds: filmsearch / local.
IMAGE_PREFIX=ghcr.io/<github-owner>/filmsearch
FILMSEARCH_TAG=v0.20.0

# Public host name (DNS A/AAAA record to this server) and the URL the browser uses. Caddy gets the certificate.
SITE_ADDRESS=demo.example.com
PUBLIC_URL=https://demo.example.com

# Letters and digits only (it goes into a connection string): openssl rand -hex 24
POSTGRES_PASSWORD=

# Admin account, created on the first start (spec 05 FR-USR-3).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Chat model: OpenRouter. Use a key of its own with a credit limit (README "Demo environment").
CHAT_PROFILE=openrouter
OPENROUTER_API_KEY=

# Embeddings: openrouter (Qwen3-Embedding-8B, uses the key above; the default).
EMBEDDING_PROFILE=openrouter

# Local runs only: CHAT_PROFILE=local and/or EMBEDDING_PROFILE=local use LM Studio on the Docker host (no key needed).
# LMSTUDIO_URL=http://host.docker.internal:1234/v1

# `dashboard` starts the Aspire dashboard (then also set OTEL_EXPORTER_OTLP_ENDPOINT=http://dashboard:18889).
COMPOSE_PROFILES=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Payments: Fake (the built-in fake gateway) or Stripe (test mode keys only: sk_test_…, and the signing secret of a
# webhook endpoint https://<host>/api/payments/webhooks/stripe in the Stripe dashboard).
PAYMENTS_PROVIDER=Fake
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: TMDB import jobs in the Worker (v4 read access token).
TMDB_API_KEY=
