{
  "openapi": "3.1.1",
  "info": {
    "title": "FilmSearch.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Searches movies by free text with catalog filters. Movie texts in the Accept-Language locale.",
        "operationId": "SearchMovies",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/info": {
      "get": {
        "tags": [
          "AppInfo"
        ],
        "summary": "Application name and version.",
        "operationId": "GetAppInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/movies": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Paged movie list with filters and sorting. Texts in the Accept-Language locale.",
        "operationId": "ListMovies",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 10000,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "maxLength": 20,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "genres",
            "in": "query",
            "schema": {
              "maxLength": 500,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "yearFrom",
            "in": "query",
            "schema": {
              "maximum": 2100,
              "minimum": 1870,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "yearTo",
            "in": "query",
            "schema": {
              "maximum": 2100,
              "minimum": 1870,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "minRating",
            "in": "query",
            "schema": {
              "maximum": 10,
              "minimum": 0,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": [
                "number",
                "string"
              ],
              "format": "double"
            }
          },
          {
            "name": "runtimeMin",
            "in": "query",
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "runtimeMax",
            "in": "query",
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "maxLength": 3,
              "minLength": 2,
              "type": "string"
            }
          },
          {
            "name": "priceMax",
            "in": "query",
            "schema": {
              "maximum": 1000000,
              "minimum": 0,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          },
          {
            "name": "offerType",
            "in": "query",
            "schema": {
              "maxLength": 10,
              "minLength": 0,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfMovieSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/movies/{id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Movie details with genres, credits and offers. Texts in the Accept-Language locale.",
        "operationId": "GetMovie",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/genres": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Genres with names in the Accept-Language locale.",
        "operationId": "ListGenres",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GenreItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/ingestion/seed": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Loads the seed file into the catalog. Idempotent: upsert by TMDB id.",
        "operationId": "LoadSeed",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeedResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppInfoResponse": {
        "required": [
          "name",
          "version"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "CastItem": {
        "required": [
          "id",
          "name",
          "character"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "character": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GenreItem": {
        "required": [
          "id",
          "slug",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "MovieDetails": {
        "required": [
          "id",
          "tmdbId",
          "imdbId",
          "title",
          "originalTitle",
          "originalLanguage",
          "releaseDate",
          "year",
          "runtimeMinutes",
          "overview",
          "tagline",
          "posterPath",
          "backdropPath",
          "voteAverage",
          "voteCount",
          "keywords",
          "genres",
          "directors",
          "writers",
          "cast",
          "offers"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tmdbId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "imdbId": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": "string"
          },
          "originalTitle": {
            "type": "string"
          },
          "originalLanguage": {
            "type": "string"
          },
          "releaseDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "runtimeMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "overview": {
            "type": [
              "null",
              "string"
            ]
          },
          "tagline": {
            "type": [
              "null",
              "string"
            ]
          },
          "posterPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "backdropPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "voteAverage": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "voteCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "genres": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GenreItem"
            }
          },
          "directors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonItem"
            }
          },
          "writers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonItem"
            }
          },
          "cast": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CastItem"
            }
          },
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferItem"
            }
          }
        }
      },
      "MovieSummary": {
        "required": [
          "id",
          "title",
          "originalTitle",
          "year",
          "runtimeMinutes",
          "overview",
          "posterPath",
          "voteAverage",
          "voteCount",
          "genres",
          "offers"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "originalTitle": {
            "type": "string"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "runtimeMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "overview": {
            "type": [
              "null",
              "string"
            ]
          },
          "posterPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "voteAverage": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "voteCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "genres": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GenreItem"
            }
          },
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferItem"
            }
          }
        }
      },
      "OfferItem": {
        "required": [
          "id",
          "type",
          "priceMinor",
          "currency",
          "rentalHours"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/OfferType"
          },
          "priceMinor": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "rentalHours": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "OfferType": {
        "enum": [
          "buy",
          "rent"
        ]
      },
      "PagedResultOfMovieSummary": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MovieSummary"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PersonItem": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "SearchDebug": {
        "type": "object",
        "properties": {
          "keywordRank": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "keywordScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "`ts_rank_cd` over the best-matching text search config, normalized to 0–1.",
            "format": "double"
          },
          "keywordMatch": {
            "type": [
              "null",
              "string"
            ],
            "description": "`all`: every query term matched (`websearch_to_tsquery`). `any`: no movie matched all terms, so the query was relaxed to match any term."
          },
          "vectorRank": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "similarity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "fusedScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        },
        "description": "Retrieval details of one item (spec 05 §4). Fields of retrievers that did not run are null. Ranks start at 1 and are positions in that retriever's list."
      },
      "SearchFilters": {
        "type": "object",
        "properties": {
          "genres": {
            "maxItems": 30,
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Genre slugs; a movie matches any of them."
          },
          "yearFrom": {
            "maximum": 2100,
            "minimum": 1870,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "yearTo": {
            "maximum": 2100,
            "minimum": 1870,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "minRating": {
            "maximum": 10,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "runtimeMin": {
            "maximum": 1000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "runtimeMax": {
            "maximum": 1000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "language": {
            "maxLength": 3,
            "minLength": 2,
            "type": [
              "null",
              "string"
            ],
            "description": "Original language, ISO 639-1 (e.g. `en`, `sv`)."
          },
          "priceMax": {
            "maximum": 1000000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "Maximum price in minor units (cents).",
            "format": "int64"
          },
          "offerType": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OfferType"
              }
            ]
          }
        },
        "description": "Catalog filters in a JSON body (FR-SRCH-5). Same meaning and limits as the `GET /api/movies` query."
      },
      "SearchItem": {
        "required": [
          "movie",
          "score",
          "debug"
        ],
        "type": "object",
        "properties": {
          "movie": {
            "description": "The movie in the requested locale.",
            "$ref": "#/components/schemas/MovieSummary"
          },
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Score of the mode that produced the list: keyword rank score, similarity or fused score. Higher is better.",
            "format": "double"
          },
          "debug": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Retrieval details, when requested.",
                "$ref": "#/components/schemas/SearchDebug"
              }
            ]
          }
        }
      },
      "SearchMode": {
        "enum": [
          "keyword",
          "semantic",
          "hybrid",
          null
        ]
      },
      "SearchRequest": {
        "required": [
          "query"
        ],
        "type": "object",
        "properties": {
          "query": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
            "description": "Free text in English, Russian or Swedish."
          },
          "mode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "`keyword` (default). `semantic` and `hybrid` return 400 until I06 / I07.",
                "$ref": "#/components/schemas/SearchMode"
              }
            ]
          },
          "filters": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The same filters as `GET /api/movies`, applied inside the search query.",
                "$ref": "#/components/schemas/SearchFilters"
              }
            ]
          },
          "understand": {
            "type": "boolean",
            "description": "Run query understanding (FR-SRCH-4). Not available until I07: `true` returns 400."
          },
          "page": {
            "maximum": 10000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "maximum": 50,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "debug": {
            "type": "boolean",
            "description": "Include per-item retrieval scores (`debug`)."
          }
        },
        "description": "Body of `POST /api/search` (spec 04 \"Search\"). Validated at the boundary; invalid input → 400 Problem Details."
      },
      "SearchResponse": {
        "required": [
          "items",
          "appliedFilters",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchItem"
            },
