            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "updated": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "unchanged": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "elapsedMilliseconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "UnderstoodFilters": {
        "type": "object",
        "properties": {
          "genresInclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Genre slugs the movie should have (any of them)."
          },
          "genresExclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Genre slugs the movie must not have."
          },
          "yearFrom": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "yearTo": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "minRating": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "maxPriceMinor": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "Maximum price in minor units (cents).",
            "format": "int64"
          },
          "language": {
            "type": [
              "null",
              "string"
            ],
            "description": "Original language, ISO 639-1."
          }
        },
        "description": "Filters found by query understanding. Null or empty means \"not mentioned\"."
