              "null",
              "string"
            ],
            "description": "Original language, ISO 639-1 (e.g. `en`, `sv`)."
          },
          "priceMax": {
            "maximum": 1000000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "Maximum price in minor units (cents).",
            "format": "int64"
          },
          "offerType": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OfferType"
              }
            ]
          }
        },
        "description": "Catalog filters in a JSON body (FR-SRCH-5). Same meaning and limits as the `GET /api/movies` query."
      },
      "SearchItem": {
        "required": [
          "movie",
          "score",
          "debug"
        ],
        "type": "object",
        "properties": {
          "movie": {
            "description": "The movie in the requested locale.",
            "$ref": "#/components/schemas/MovieSummary"
          },
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Score of the mode that produced the list: keyword rank score, similarity or fused score. Higher is better.",
            "format": "double"
          },
          "debug": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Retrieval details, when requested.",
                "$ref": "#/components/schemas/SearchDebug"
              }
            ]
          }
        }
      },
      "SearchMode": {
        "enum": [
          "keyword",
          "semantic",
          "hybrid",
          null
        ]
      },
      "SearchRequest": {
        "required": [
          "query"
        ],
        "type": "object",
        "properties": {
          "query": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
            "description": "Free text in English, Russian or Swedish."
          },
          "mode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "`hybrid` (default), `keyword` or `semantic`.",
                "$ref": "#/components/schemas/SearchMode"
              }
            ]
          },
          "filters": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The same filters as `GET /api/movies`, applied inside the search query.",
                "$ref": "#/components/schemas/SearchFilters"
              }
            ]
          },
          "understand": {
            "type": "boolean",
            "description": "Turn the free text into filters and a search text with the LLM first (FR-SRCH-4); explicit filters win over found ones."
          },
          "page": {
            "maximum": 10000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "maximum": 50,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "debug": {
            "type": "boolean",
            "description": "Include per-item retrieval scores (`debug`)."
          }
        },
        "description": "Body of `POST /api/search` (spec 04 \"Search\"). Validated at the boundary; invalid input → 400 Problem Details."
      },
      "SearchResponse": {
        "required": [
          "items",
          "appliedFilters",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchItem"
            },
            "description": "Found movies, best first."
          },
          "appliedFilters": {
            "description": "The filters the search used, normalized: the request's filters merged with the ones found by query understanding.",
            "$ref": "#/components/schemas/SearchFilters"
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Page number, starting at 1.",
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Items per page.",
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of matching movies (keyword), or length of the result list (semantic: at most 100; hybrid: union of the fused candidate lists).",
            "format": "int32"
          },
          "understoodQuery": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Result of query understanding when `understand` was true.",
                "$ref": "#/components/schemas/UnderstoodQuery"
              }
            ]
          },
          "degraded": {
            "type": "boolean",
            "description": "Hybrid search returned keyword results only because the query could not be embedded.",
            "default": false
          }
        }
      },
      "SeedResult": {
        "required": [
          "genres",
          "created",
          "updated",
          "unchanged",
          "elapsedMilliseconds"
        ],
        "type": "object",
        "properties": {
          "genres": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
