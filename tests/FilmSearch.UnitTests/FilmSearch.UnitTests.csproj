<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real Stripe test mode events captured with the Stripe CLI (I15). -->
    <None Include="Commerce\StripeEvents\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded TMDB responses and the fake TMDB API shared by the unit and integration tests (I16). -->
    <None Include="..\fixtures\tmdb\*.json" Link="fixtures\tmdb\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\fixtures\TmdbStub.cs" Link="Fixtures\TmdbStub.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FilmSearch.Api\FilmSearch.Api.csproj" />
    <ProjectReference Include="..\..\evals\FilmSearch.Evals\FilmSearch.Evals.csproj" />
  </ItemGroup>

</Project>
