<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- IHttpClientFactory (Stripe gateway, TMDB client) and hosting (Worker services) from the shared framework, as in FilmSearch.AI. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- TMDB client (I16): its own retry, rate limiter (Polly.RateLimiting) and timeouts instead of the standard handler. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
    <PackageReference Include="Stripe.net" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FilmSearch.UnitTests" />
    <InternalsVisibleTo Include="FilmSearch.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FilmSearch.Core\FilmSearch.Core.csproj" />
  </ItemGroup>

</Project>
