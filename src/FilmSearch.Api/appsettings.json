{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Search": {
    "Semantic": {
      "MaxResults": 100
    },
    "Hybrid": {
      "RrfK": 20,
      "KeywordWeight": 1.0,
      "RelaxedKeywordWeight": 0.1,
      "SemanticWeight": 1.0,
      "CandidatesPerList": 50,
      "SimilarTitles": "AverageVector"
    },
    "QueryUnderstanding": {
      "CacheMinutes": 60
    },
    "Embeddings": {
      "Locales": [ "en" ],
      "BatchSize": 32
    }
  },
  "Jobs": {
    "PollIntervalMs": 2000,
    "HeartbeatIntervalMs": 2000,
    "LeaseSeconds": 60,
    "MaxAttempts": 3
  },
  "Tmdb": {
    "RequestsPerWindow": 40,
    "WindowSeconds": 10,
    "MaxConcurrency": 4,
    "Schedule": {
      "Enabled": false,
      "TimeUtc": "03:00",
      "List": "Popular",
      "Pages": 5
    }
  },
  "Commerce": {
    "PaymentTimeoutMinutes": 30,
    "ExpiryScanSeconds": 60,
    "SuccessUrl": "/checkout/success?orderId={orderId}",
    "CancelUrl": "/checkout/cancel?orderId={orderId}"
  },
  "Assistant": {
    "MaxToolIterations": 6,
    "HistoryMaxMessages": 12,
    "HistoryTokenBudget": 3000,
    "MaxConversationTokens": 300000,
    "MaxOwnerTokensPerDay": 1000000,
    "SearchResultLimit": 6,
    "SummaryMaxOutputTokens": 400,
    "ConfirmationTtlMinutes": 15
  },
  "Payments": {
    "Provider": "Fake",
    "Fake": {
      "WebhookDelayMinMs": 1000,
      "WebhookDelayMaxMs": 3000,
      "DuplicateDeliveries": 0,
      "DeliverFailuresLate": false
    }
  },
  "AI": {
    "ActiveChatProfile": "local",
    "ActiveEmbeddingProfile": "local",
    "ChatProfiles": {
      "local": {
        "Endpoint": "http://localhost:1234/v1",
        "Model": "google/gemma-4-e4b",
        "ApiKey": "lm-studio",
        "Temperature": 0.3,
        "MaxOutputTokens": 1024,
        "ReasoningEffort": "None",
        "SupportsTools": true,
        "TimeoutSeconds": 300
      },
      "openrouter": {
        "Endpoint": "https://openrouter.ai/api/v1",
        "Model": "deepseek/deepseek-v4.1-flash-1017",
        "Temperature": 0.3,
        "MaxOutputTokens": 1024,
        "ReasoningEffort": "None",
        "SupportsTools": true,
        "TimeoutSeconds": 120
      }
    },
    "EmbeddingProfiles": {
      "local": {
        "Endpoint": "http://localhost:1234/v1",
        "Model": "text-embedding-embeddinggemma-300m",
        "ApiKey": "lm-studio",
        "Dimensions": 768,
        "QueryPrefix": "task: search result | query: ",
        "DocumentPrefix": "title: none | text: "
      },
      "nomic": {
        "Endpoint": "http://localhost:1234/v1",
        "Model": "text-embedding-nomic-embed-text-v1.5",
        "ApiKey": "lm-studio",
        "Dimensions": 768,
        "QueryPrefix": "search_query: ",
        "DocumentPrefix": "search_document: "
      }
    },
    "Pricing": {
      "anthropic/claude-haiku-5.5": { "InputPerMTokUsd": 0.1, "OutputPerMTokUsd": 0.5 },
      "openai/gpt-6-luna": { "InputPerMTokUsd": 0.1, "OutputPerMTokUsd": 0.5 },
      "deepseek/deepseek-v4.1-flash-1017": { "InputPerMTokUsd": 0.036, "OutputPerMTokUsd": 0.5 },
      "qwen/qwen3.8-flash": { "InputPerMTokUsd": 0.15, "OutputPerMTokUsd": 0.47 },
      "z-ai/glm-5.3-flash": { "InputPerMTokUsd": 0.15, "OutputPerMTokUsd": 0.5 }
    }
  }
}
