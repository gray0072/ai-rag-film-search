{
  "openapi": "3.1.1",
  "info": {
    "title": "FilmSearch.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Searches movies by free text with catalog filters. Movie texts in the Accept-Language locale.",
        "operationId": "SearchMovies",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/movies/{id}/similar": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Movies nearest to this one by embedding (cosine similarity), best first. Empty while the movie has no vector.",
        "operationId": "GetSimilarMovies",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchItem"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/info": {
      "get": {
        "tags": [
          "AppInfo"
        ],
        "summary": "Application name and version.",
        "operationId": "GetAppInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/movies": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Paged movie list with filters and sorting. Texts in the Accept-Language locale.",
        "operationId": "ListMovies",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 10000,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "maxLength": 20,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "genres",
            "in": "query",
            "schema": {
              "maxLength": 500,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "yearFrom",
            "in": "query",
            "schema": {
              "maximum": 2100,
              "minimum": 1870,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "yearTo",
            "in": "query",
            "schema": {
              "maximum": 2100,
              "minimum": 1870,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "minRating",
            "in": "query",
            "schema": {
              "maximum": 10,
              "minimum": 0,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": [
                "number",
                "string"
              ],
              "format": "double"
            }
          },
          {
            "name": "runtimeMin",
            "in": "query",
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "runtimeMax",
            "in": "query",
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "maxLength": 3,
              "minLength": 2,
              "type": "string"
            }
          },
          {
            "name": "priceMax",
            "in": "query",
            "schema": {
              "maximum": 1000000,
              "minimum": 0,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          },
          {
            "name": "offerType",
            "in": "query",
            "schema": {
              "maxLength": 10,
              "minLength": 0,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfMovieSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/movies/{id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Movie details with genres, credits and offers. Texts in the Accept-Language locale.",
        "operationId": "GetMovie",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/genres": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Genres with names in the Accept-Language locale.",
        "operationId": "ListGenres",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GenreItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/ingestion/seed": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Loads the seed file into the catalog. Idempotent: upsert by TMDB id.",
        "operationId": "LoadSeed",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeedResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/ai/chat": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Sends one message to a chat profile (default: the active one) and returns the answer with token usage.",
        "operationId": "AdminAiChat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminAiChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAiChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/embeddings": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Active embedding model, stored vectors per model and locale, and the current or last reindex job.",
        "operationId": "GetEmbeddingIndex",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingIndexState"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Admin"
        ],
        "summary": "Deletes all vectors of a model that is not the active one.",
        "operationId": "DeleteEmbeddingModel",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteEmbeddingsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/embeddings/reindex": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Starts a background reindex job (202). 409 while another job is queued or running.",
        "operationId": "ReindexEmbeddings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminReindexRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingJobStatus"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingJobStatus"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminAiChatRequest": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string",
            "description": "The user message."
          },
          "profile": {
            "maxLength": 100,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ],
            "description": "Chat profile name from `AI:ChatProfiles`; the active profile when empty."
          }
        },
        "description": "Body of `POST /api/admin/ai/chat`."
      },
      "AdminAiChatResponse": {
        "required": [
          "profile",
          "model",
          "text",
          "inputTokens",
          "outputTokens",
          "estimatedCostUsd"
        ],
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "inputTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "outputTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "estimatedCostUsd": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        },
        "description": "Answer of a chat profile with token usage and estimated cost (null when the model has no price)."
      },
      "AdminReindexRequest": {
        "type": "object",
        "properties": {
          "profile": {
            "maxLength": 100,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ],
            "description": "Embedding profile from `AI:EmbeddingProfiles`; the active one when empty."
          },
          "onlyStale": {
            "type": "boolean",
            "description": "Embed only movies whose embedding text changed (default). False re-embeds every movie."
          },
          "locales": {
            "maxItems": 3,
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Locales to keep vectors for (`en`, `ru`, `sv`); `Search:Embeddings:Locales` when empty. Vectors of other locales of this model are deleted."
          }
        },
        "description": "Body of `POST /api/admin/embeddings/reindex`."
      },
      "AppInfoResponse": {
        "required": [
          "name",
          "version"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "CastItem": {
        "required": [
          "id",
          "name",
          "character"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "character": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DeleteEmbeddingsResponse": {
        "required": [
          "model",
          "deleted"
        ],
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "deleted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "EmbeddingIndexState": {
        "required": [
          "activeProfile",
          "activeModel",
          "activeDimensions",
          "sets",
          "job"
        ],
        "type": "object",
        "properties": {
          "activeProfile": {
            "type": "string"
          },
          "activeModel": {
            "type": "string"
          },
          "activeDimensions": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmbeddingSetStats"
            }
          },
          "job": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EmbeddingJobStatus"
              }
            ]
          }
        },
        "description": "State of the embedding index: the active model and the stored vectors of every model."
      },
      "EmbeddingJobState": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "EmbeddingJobStatus": {
        "required": [
          "id",
          "state",
          "request",
          "queuedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "$ref": "#/components/schemas/EmbeddingJobState"
          },
          "request": {
            "$ref": "#/components/schemas/ReindexRequest"
          },
          "queuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "progress": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReindexProgress"
              }
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReindexResult"
              }
            ]
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "description": "State of a background reindex job. `Progress` while it runs, `Result` when it succeeded, `Error` when it failed."
      },
      "EmbeddingSetStats": {
        "required": [
          "model",
          "dimensions",
          "locale",
          "count"
        ],
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "dimensions": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "locale": {
            "type": "string"
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Number of stored vectors of one model and locale."
      },
      "GenreItem": {
        "required": [
          "id",
          "slug",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "MovieDetails": {
        "required": [
          "id",
          "tmdbId",
          "imdbId",
          "title",
          "originalTitle",
          "originalLanguage",
          "releaseDate",
          "year",
          "runtimeMinutes",
          "overview",
          "tagline",
          "posterPath",
          "backdropPath",
          "voteAverage",
          "voteCount",
          "keywords",
          "genres",
          "directors",
          "writers",
          "cast",
          "offers"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tmdbId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "imdbId": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": "string"
          },
          "originalTitle": {
            "type": "string"
          },
          "originalLanguage": {
            "type": "string"
          },
          "releaseDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "runtimeMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "overview": {
            "type": [
              "null",
              "string"
            ]
          },
          "tagline": {
            "type": [
              "null",
              "string"
            ]
          },
          "posterPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "backdropPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "voteAverage": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "voteCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "genres": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GenreItem"
            }
          },
          "directors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonItem"
            }
          },
          "writers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonItem"
            }
          },
          "cast": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CastItem"
            }
          },
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferItem"
            }
          }
        }
      },
      "MovieSummary": {
        "required": [
          "id",
          "title",
          "originalTitle",
          "year",
          "runtimeMinutes",
          "overview",
          "posterPath",
          "voteAverage",
          "voteCount",
          "genres",
          "offers"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "originalTitle": {
            "type": "string"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "runtimeMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "overview": {
            "type": [
              "null",
              "string"
            ]
          },
          "posterPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "voteAverage": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "voteCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "genres": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GenreItem"
            }
          },
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferItem"
            }
          }
        }
      },
      "OfferItem": {
        "required": [
          "id",
          "type",
          "priceMinor",
          "currency",
          "rentalHours"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/OfferType"
          },
          "priceMinor": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "rentalHours": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "OfferType": {
        "enum": [
          "buy",
          "rent"
        ]
      },
      "PagedResultOfMovieSummary": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MovieSummary"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PersonItem": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "QueryUnderstandingSource": {
        "enum": [
          "llm",
          "cache",
          "fallback"
        ],
        "description": "Where an UnderstoodQuery came from."
      },
      "ReindexProgress": {
        "required": [
          "total",
          "processed",
          "embedded",
          "unchanged"
        ],
        "type": "object",
        "properties": {
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "processed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "embedded": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "unchanged": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Progress of a reindex: `Processed` of `Total` movie texts (movies × locales) checked so far."
      },
      "ReindexRequest": {
        "type": "object",
        "properties": {
          "profile": {
            "type": [
              "null",
              "string"
            ]
          },
          "onlyStale": {
            "type": "boolean",
            "default": true
          },
          "locales": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "description": "What to (re)embed. `Profile`: embedding profile, the active one when null. `OnlyStale`: embed only movies whose text hash changed; false re-embeds everything. `Locales`: locales to keep vectors for, the configured ones when null; vectors of other locales of this model are deleted."
      },
      "ReindexResult": {
        "required": [
          "profile",
          "model",
          "dimensions",
          "locales",
          "movies",
          "embedded",
          "unchanged",
          "deleted",
          "elapsedMilliseconds"
        ],
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "dimensions": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "locales": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "movies": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "embedded": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "unchanged": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "deleted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "elapsedMilliseconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        },
        "description": "Outcome of a reindex. `Deleted`: vectors of this model for locales that are no longer indexed."
      },
      "SearchDebug": {
        "type": "object",
        "properties": {
          "keywordRank": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "keywordScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "`ts_rank_cd` over the best-matching text search config, normalized to 0–1.",
            "format": "double"
          },
          "keywordMatch": {
            "type": [
              "null",
              "string"
            ],
            "description": "`all`: every query term matched (`websearch_to_tsquery`). `any`: no movie matched all terms, so the query was relaxed to match any term."
          },
          "vectorRank": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "similarity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "fusedScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        },
        "description": "Retrieval details of one item (spec 05 §4). Fields of retrievers that did not run are null. Ranks start at 1 and are positions in that retriever's list."
      },
      "SearchFilters": {
        "type": "object",
        "properties": {
          "genres": {
            "maxItems": 30,
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Genre slugs; a movie matches any of them."
